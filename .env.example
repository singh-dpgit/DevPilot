# ============================================================================
# DevPilot Environment Configuration Template (.env.example)
#
# Copy this file to `.env` or export these variables in your terminal/IDE
# before starting the Spring Boot backend.
# Never commit real API keys, client secrets, or passwords to version control!
# ============================================================================

# 1. PostgreSQL + pgvector Database (matches docker-compose.yml defaults)
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 2. GitHub OAuth2 Application Credentials
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:8080
# - Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# 3. OpenAI API Key (used by Spring AI for text-embedding-3-small & gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here

# 4. Token Encryption Settings (encrypts GitHub OAuth tokens stored in Postgres)
TOKEN_ENCRYPTOR_PASSWORD=devpilot-local-encrypt-key-change-me
# Must be exactly 16 hexadecimal characters (0-9, a-f). Keep constant once set!
TOKEN_ENCRYPTOR_SALT=deadbeecfcafebab

# 5. Application & CORS URLs
# Spring Boot serves the plain HTML/CSS/JS frontend from src/main/resources/static/ at http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
