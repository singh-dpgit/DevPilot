```gitignore
# Help files
HELP.md

# Environment variables and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Maven
target/
**/target/

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Gradle
.gradle/
build/
**/build/

# VS Code
.vscode/

# Logs
*.log
logs/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
*.swp
*.swo

# Python cache
__pycache__/
*.py[cod]

# Test reports
surefire-reports/
failsafe-reports/
```